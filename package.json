{
  "name": "ticket-counter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-transform-types --enable-source-maps --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test 'tests/**/*.test.ts'",
    "test:watch": "npm test -- --watch",
    "typecheck": "tsc --noEmit",
    "backup": "node scripts/backup.mjs --with-uploads --keep 30",
    "seed:bazaar": "node scripts/seed-bazaar.mjs",
    "audit": "node scripts/audit-bazaar.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "better-sqlite3": "^12.2.0",
    "next": "^15.4.5",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.2.0",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2"
  }
}
