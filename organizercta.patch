 }
+
+/* ---------- "Become an organizer" invitation (event page) ----------
+   Sits at the foot of every event page, because an organizer's link is how
+   most people reach this site at all and the home page's pitch never gets
+   seen. Deliberately the quietest panel on the page: the event belongs to the
+   organizer who built it, and this must never pull attention off their sale.
+   Neutral surface rather than the per-event accent — it is the platform
+   speaking, not the event. */
+
+.org-pitch {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 22px;
+  flex-wrap: wrap;
+  max-width: 780px;
+  padding: 22px 24px;
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  background: var(--bg-elevated);
+}
+
+.org-pitch-text {
+  flex: 1 1 320px;
+  min-width: 0;
+}
+
+.org-pitch-kicker {
+  margin: 0 0 4px;
+  font-size: 0.74rem;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--green);
+}
+
+.org-pitch-title {
+  font-family: var(--font-display, var(--font));
+  font-size: 1.15rem;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  margin: 0 0 6px;
+}
+
+.org-pitch-body {
+  margin: 0;
+  color: var(--text-dim);
+  font-size: 0.9rem;
+  max-width: 54ch;
+}
+
+.org-pitch-actions {
+  margin: 0;
+  flex: none;
+}
+
+/* On a phone the button goes full width rather than sitting orphaned under a
+   paragraph it is no longer beside. */
+@media (max-width: 560px) {
+  .org-pitch-actions,
+  .org-pitch-actions .btn {
+    width: 100%;
+    justify-content: center;
+  }
+}
+
+/* ---------- Header navigation ----------
+   Two real buttons now live up here, so the row needs rules of its own rather
+   than an inline gap. On a narrow screen both labels were wrapping onto two
+   lines each, which doubled the header's height and made the whole thing look
+   broken — so the labels never wrap, and the buttons tighten instead. */
+
+.header-nav {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.header-nav .btn {
+  white-space: nowrap;
+}
+
+@media (min-width: 560px) {
+  .header-nav {
+    gap: 14px;
+  }
+}
+
+@media (max-width: 420px) {
+  .header-nav {
+    gap: 7px;
+  }
+
+  .header-nav .btn {
+    padding-left: 10px;
+    padding-right: 10px;
+    font-size: 0.78rem;
+  }
+
+  /* The wordmark yields first: it is a link home, and the header already has
+     the flag icon carrying the brand. */
+  .header-inner {
+    gap: 10px;
+  }
+}
+
+/* Below ~460px the wordmark, two full-width button labels and the gaps between
+   them need 411px of a 320px row, and the sign-in button was being cut off at
+   the screen edge. The wordmark yields rather than the buttons: the flag mark
+   beside it still identifies the site and still links home, the brand name is
+   repeated in the page below and in the footer, and shortening the two actions
+   instead would leave the only navigation on the page reading "Browse" and
+   "Sign in" — which is the half that has to stay unambiguous. */
+@media (max-width: 460px) {
+  .site-header .logo-word {
+    display: none;
+  }
+}
